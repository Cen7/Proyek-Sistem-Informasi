<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="initial-scale=1, width=device-width" />
  <link rel="stylesheet" href="/css/global-ulasan.css" />
  <link rel="stylesheet" href="/css/admin-ulasan.css" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&display=swap" />
</head>

<body>
  <%- include('./layout/sidebar.ejs') %>
  <%- include('./layout/header-search.ejs', { searchAction: '/admin-ulasan', searchQuery: searchQuery }) %>

  <div class="h4-heading">All (<%= dataCount %>)</div>
  <table class="tabel-verifikasi-lapak">
    <thead>
      <tr class="informasi-table-verifikasi">
        <th>Nama Reviewer</th>
        <th class="ulasan">Deskripsi Ulasan</th>
        <th>Rating</th>
        <th>Nama Lapak</th>
        <th>Alamat Lapak</th>
        <th>Tanggal Ulasan</th>
        <th>Total Laporan</th>
        <th>Informasi Ulasan</th>
      </tr>
    </thead>
    <tbody>
      <% lapakList.forEach(lapak => { %>
        <tr>
          <td><%= lapak.reviewer %></td>
          <td><%= lapak.deskripsi %></td>
          <td class="deskripsi-table-verifikasi"><%= lapak.rating %></td>
          <td><%= lapak.nama_lapak %></td>
          <td><%= lapak.lokasi_lapak %></td>
          <td class="deskripsi-table-verifikasi">
            <%= moment(lapak.tanggal).format("YYYY-MM-DD") %>
          </td>
          <td class="deskripsi-table-verifikasi"><%= lapak.count_laporan %></td>
          <td class="deskripsi-table-verifikasi">
            <a href="/admin-ulasan-laporan/<%= lapak.id_ulasan %>">
              <button class="action-button">. . .</button>
            </a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <div class="pagination">
    <a href="?page=<%= currentPage > 1 ? currentPage - 1 : 1 %>&search=<%= searchQuery %>">&laquo;</a>
    <% for (let i = 1; i <= pageCount; i++) { %>
      <a href="?page=<%= i %>&search=<%= searchQuery %>" class="<%= currentPage === i ? 'active' : '' %>">
        <%= i %>
      </a>
    <% } %>
    <a href="?page=<%= currentPage < pageCount ? currentPage + 1 : pageCount %>&search=<%= searchQuery %>">&raquo;</a>
  </div>

</body>

</html>
